{
  "name": "classman",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --experimental-strip-types prisma/seed.ts",
    "db:bootstrap": "node --env-file=.env --experimental-strip-types prisma/bootstrap-admin.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "unrs-resolver": true
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.6.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.14",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-filename": "^1.6.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-filename": "^1.1.28",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.19.0",
    "typescript": "^5.9.0"
  }
}
